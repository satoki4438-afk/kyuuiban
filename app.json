{
  "expo": {
    "name": "kyuuiban",
    "slug": "kyuuiban",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/123.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/123.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0B2E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "吉方位のスポットを探すために現在地を使用します"
      }
    },
    "android": {
      "permissions": ["ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/123.png",
        "backgroundColor": "#1A0B2E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/123.png",
          "color": "#1A0B2E",
          "sounds": []
        }
      ]
    ]
  }
}
